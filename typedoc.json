{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts",
    "src/http/index.ts",
    "src/catalog/index.ts"
  ],
  "tsconfig": "tsconfig.build.json",
  "json": "docs/typedoc.json",
  "emit": "docs",
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "skipErrorChecking": true,
  "logLevel": "Warn",
  "readme": "none"
}
